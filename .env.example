# Replace with the reveal-once daemon token from the Portless join/admin flow.
PORTLESS_DEVICE_TOKEN=replace-with-reveal-once-token
PORTLESS_PMS_URL=http://plex
PORTLESS_CONTROL_URL=http://host.docker.internal:8080
PORTLESS_DATA_DIR=/var/lib/portless
PORTLESS_KEEPALIVE_PROFILE=residential
# The example Compose file publishes this container bind only on host loopback.
PORTLESS_UI_ADDR=0.0.0.0:43180
RUST_LOG=info
